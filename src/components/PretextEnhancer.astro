---
// PretextEnhancer.astro
// CJK/Latin 混排排版增强引擎
// 视口感知：桌面使用 @chenglou/pretext 精确测量，移动端用 CSS class 驱动
// 渐进增强：JS 失败或字体未加载时，CSS 基线布局不受影响
---

<script>
import { prepare, layout, prepareWithSegments, layoutWithLines } from '@chenglou/pretext';

// ── CJK 检测 ──

/** CJK 字符正则（统一表意文字 + 扩展区 + 全角标点） */
const CJK_RE = /[\u4e00-\u9fff\u3400-\u4dbf\uf900-\ufaff\u{20000}-\u{2a6df}\u{2a700}-\u{2ebef}\u3000-\u303f\uff00-\uffef]/gu;

/** 计算文本中 CJK 字符占比 (0~1)，排除代码片段 */
function cjkRatio(text: string): number {
  // 移除行内代码内容，避免干扰比例计算
  const cleaned = text.replace(/`[^`]+`/g, '').replace(/\s/g, '');
  const chars = [...cleaned];
  if (chars.length === 0) return 0;
  return (cleaned.match(CJK_RE) || []).length / chars.length;
}

// ── 段落过滤 ──

/** 判断段落是否应跳过排版增强 */
function shouldSkipParagraph(p: HTMLParagraphElement): boolean {
  const text = p.textContent || '';
  if (text.trim().length < 10) return true;

  // 段落中代码占比 > 40% 则跳过
  const codeLength = Array.from(p.querySelectorAll('code'))
    .reduce((acc, el) => acc + (el.textContent?.length || 0), 0);
  if (codeLength > text.length * 0.4) return true;

  return false;
}

// ── Line-height 计算 ──

/** 根据 CJK 比例和视口宽度计算最佳 line-height */
function optimalLineHeight(ratio: number, viewportWidth: number): number {
  // 移动端 CJK 需要稍多呼吸空间
  const mobileBoost = viewportWidth < 640 ? 0.05 : 0;

  if (ratio > 0.7) return 1.95 + mobileBoost;  // 纯 CJK
  if (ratio > 0.4) return 1.85 + mobileBoost;  // 重度混排
  if (ratio > 0.15) return 1.8 + mobileBoost;   // 轻度混排
  return 0; // 纯 Latin → 使用 CSS 默认 --lh-body: 1.75，不覆盖
}

/** CJK 比例 → CSS class 名 */
function cjkClassName(ratio: number): string | null {
  if (ratio > 0.7) return 'cjk-heavy';
  if (ratio > 0.4) return 'cjk-mixed';
  if (ratio > 0.15) return 'cjk-light';
  return null;
}

// ── 工具函数 ──

/** 获取元素 computed font 字符串 */
function getFont(el: HTMLElement): string {
  const cs = getComputedStyle(el);
  return `${cs.fontSize} ${cs.fontFamily}`;
}

/** debounce */
function debounce(fn: () => void, ms: number): () => void {
  let timer: ReturnType<typeof setTimeout>;
  return () => {
    clearTimeout(timer);
    timer = setTimeout(fn, ms);
  };
}

// ── 文章排版增强 ──

/** 桌面/平板：使用 pretext 精确测量 + CSS 自定义属性 */
function enhanceArticleFull(vw: number): void {
  const paragraphs = document.querySelectorAll<HTMLParagraphElement>('.post-content > p');
  if (paragraphs.length === 0) return;

  // 批量读取
  const measurements: Array<{
    p: HTMLParagraphElement;
    targetLH: number;
    font: string;
    containerWidth: number;
    fontSize: number;
  }> = [];

  for (const p of paragraphs) {
    if (shouldSkipParagraph(p)) continue;
    const text = p.textContent || '';
    const ratio = cjkRatio(text);
    const targetLH = optimalLineHeight(ratio, vw);
    if (targetLH === 0) continue; // Latin, use CSS default

    const font = getFont(p);
    const containerWidth = p.clientWidth;
    const fontSize = parseFloat(getComputedStyle(p).fontSize);

    measurements.push({ p, targetLH, font, containerWidth, fontSize });
  }

  // 批量写入
  requestAnimationFrame(() => {
    for (const { p, targetLH, font, containerWidth, fontSize } of measurements) {
      const text = p.textContent || '';
      const currentLH = fontSize * 1.75; // CSS baseline
      const newLH = fontSize * targetLH;

      try {
        const prepared = prepare(text, font);
        const currentLayout = layout(prepared, containerWidth, currentLH);
        const newLayout = layout(prepared, containerWidth, newLH);

        // 行数增加超过 25% 则放弃
        if (newLayout.lineCount > currentLayout.lineCount * 1.25) continue;

        p.style.setProperty('--lh-computed', String(targetLH));
      } catch {
        // pretext 测量失败，用 class 方案作为后备
        const ratio = cjkRatio(text);
        const cls = cjkClassName(ratio);
        if (cls) p.classList.add(cls);
      }
    }
  });
}

/** 移动端：纯 class 方案，无 pretext 测量 */
function enhanceArticleSimple(): void {
  const paragraphs = document.querySelectorAll<HTMLParagraphElement>('.post-content > p');
  for (const p of paragraphs) {
    if (shouldSkipParagraph(p)) continue;
    const ratio = cjkRatio(p.textContent || '');
    const cls = cjkClassName(ratio);
    if (cls) p.classList.add(cls);
  }
}

// ── 卡片描述截断 ──

const cardOriginals = new WeakMap<HTMLElement, string>();

function enhanceCards(): void {
  const descs = document.querySelectorAll<HTMLElement>('.content-card__desc');
  if (descs.length === 0) return;

  const maxLines = 3;

  for (const desc of descs) {
    if (!cardOriginals.has(desc)) {
      cardOriginals.set(desc, desc.textContent || '');
    }
    const originalText = cardOriginals.get(desc) || '';
    if (originalText.trim().length === 0) continue;

    const font = getFont(desc);
    const containerWidth = desc.clientWidth;
    if (containerWidth <= 0) continue;

    const fontSize = parseFloat(getComputedStyle(desc).fontSize);
    const lh = parseFloat(getComputedStyle(desc).lineHeight) || fontSize * 1.6;

    try {
      const prepared = prepareWithSegments(originalText, font);
      const result = layoutWithLines(prepared, containerWidth, lh);

      if (result.lineCount <= maxLines) {
        desc.textContent = originalText;
        continue;
      }

      const truncatedLines = result.lines.slice(0, maxLines);
      let truncatedText = truncatedLines.map((line: { text: string }) => line.text).join('');
      truncatedText = truncatedText.trimEnd() + '…';
      desc.textContent = truncatedText;
    } catch {
      continue;
    }
  }
}

// ── 主入口 ──

function enhance(): void {
  const vw = window.innerWidth;

  // 移动端：跳过 pretext 测量，用 class 驱动
  if (vw < 640) {
    enhanceArticleSimple();
  } else {
    enhanceArticleFull(vw);
  }

  enhanceCards();
  document.documentElement.classList.add('pretext-ready');
}

function handleResize(): void {
  // 清除已有增强
  for (const p of document.querySelectorAll<HTMLParagraphElement>('.post-content > p')) {
    p.style.removeProperty('--lh-computed');
    p.classList.remove('cjk-heavy', 'cjk-mixed', 'cjk-light');
  }
  for (const desc of document.querySelectorAll<HTMLElement>('.content-card__desc')) {
    const original = cardOriginals.get(desc);
    if (original) desc.textContent = original;
  }
  document.documentElement.classList.remove('pretext-ready');
  enhance();
}

async function init(): Promise<void> {
  await document.fonts.ready;

  // 检测字体就绪（UI 字体或 CJK 系统字体）
  const fontReady = document.fonts.check('1em "Space Grotesk"')
    || document.fonts.check('1em "PingFang SC"')
    || document.fonts.check('1em "Noto Sans SC"')
    || document.fonts.check('1em sans-serif');

  if (!fontReady) return;

  enhance();
  window.addEventListener('resize', debounce(handleResize, 250));
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => init());
} else {
  init();
}
</script>
