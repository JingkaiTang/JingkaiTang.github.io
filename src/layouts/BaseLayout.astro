---
import { SITE } from '../consts';
import SiteFooter from '../components/theme/SiteFooter.astro';
import SiteHeader from '../components/theme/SiteHeader.astro';
import { DEFAULT_THEME, THEME_KEYS, THEME_STORAGE_KEY } from '../theme/config';
import '../styles/theme-tokens.css';
import '../styles/typography-engine.css';
import '../styles/article.css';
import '../styles/theme-components.css';
import '../styles/responsive-v2.css';
import PretextEnhancer from '../components/PretextEnhancer.astro';

const {
  title = SITE.title,
  description = SITE.description,
  // Keep a working default (we ship public/og.svg)
  ogImage = '/og.svg',
  canonical,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const siteUrl = Astro.site;
const canonicalUrl = canonical
  ? new URL(canonical, siteUrl)
  : siteUrl
    ? new URL(Astro.url.pathname, siteUrl)
    : null;

// Resolve ogImage to absolute URL for social sharing
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : siteUrl
    ? new URL(ogImage, siteUrl).toString()
    : ogImage;

const BASE_URL = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    {canonicalUrl ? <link rel="canonical" href={canonicalUrl.toString()} /> : null}

    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime ? (
      <meta property="article:published_time" content={publishedTime} />
    ) : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {siteUrl ? <meta property="og:url" content={canonicalUrl?.toString() ?? siteUrl.toString()} /> : null}
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>

    <script is:inline define:vars={{ DEFAULT_THEME, THEME_KEYS, THEME_STORAGE_KEY }}>
      (() => {
        const allowed = new Set(THEME_KEYS);
        let saved = '';
        try {
          saved = localStorage.getItem(THEME_STORAGE_KEY) || '';
        } catch {
          // ignore storage errors (private mode / blocked)
        }
        const next = allowed.has(saved) ? saved : DEFAULT_THEME;
        document.documentElement.dataset.theme = next;
      })();
    </script>

    <!-- Fonts (avoid render-blocking @import in CSS) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
    />

    <link rel="stylesheet" href="/styles.css" />

    <slot name="head" />
  </head>
  <body class="theme-default" data-base-url={BASE_URL} data-theme={DEFAULT_THEME}>
    <div class="ambient-glow"></div>

    <!-- Spring Theme: Cherry Blossom Petals -->
    <div class="spring-petals" aria-hidden="true">
      <div class="spring-petal"></div>
      <div class="spring-petal"></div>
      <div class="spring-petal"></div>
      <div class="spring-petal"></div>
      <div class="spring-petal"></div>
      <div class="spring-petal"></div>
      <div class="spring-petal"></div>
      <div class="spring-petal"></div>
      <div class="spring-petal"></div>
      <div class="spring-petal"></div>
    </div>

    <!-- Summer Theme: Night Sky, Bamboo, Fireflies -->
    <div class="summer-scene" aria-hidden="true">
      <div class="summer-moon-glow"></div>
      <div class="summer-moon"></div>
      <div class="summer-stars">
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
        <div class="summer-star"></div>
      </div>
      <div class="summer-bamboo">
        <div class="summer-cluster summer-cluster-1">
          <div class="summer-stalk s1"></div>
          <div class="summer-stalk s2"></div>
          <div class="summer-stalk s3"></div>
          <div class="summer-stalk s4"></div>
        </div>
        <div class="summer-cluster summer-cluster-2">
          <div class="summer-stalk s1"></div>
          <div class="summer-stalk s2"></div>
          <div class="summer-stalk s3"></div>
          <div class="summer-stalk s4"></div>
          <div class="summer-stalk s5"></div>
        </div>
        <div class="summer-cluster summer-cluster-3">
          <div class="summer-stalk s1"></div>
          <div class="summer-stalk s2"></div>
          <div class="summer-stalk s3"></div>
        </div>
        <div class="summer-cluster summer-cluster-4">
          <div class="summer-stalk s1"></div>
          <div class="summer-stalk s2"></div>
          <div class="summer-stalk s3"></div>
          <div class="summer-stalk s4"></div>
          <div class="summer-stalk s5"></div>
        </div>
        <div class="summer-cluster summer-cluster-5">
          <div class="summer-stalk s1"></div>
          <div class="summer-stalk s2"></div>
          <div class="summer-stalk s3"></div>
        </div>
      </div>
      <div class="summer-ground"></div>
    </div>

    <div class="summer-fireflies" aria-hidden="true">
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
      <div class="summer-firefly"></div>
    </div>

    <SiteHeader />

    <main data-pagefind-body>
      <slot />
    </main>

    <SiteFooter />

    <!-- Cmd/Ctrl+K Quick Search -->
    <dialog id="quick-search" class="quick-search" data-pagefind-ignore>
      <div class="quick-search__bar">
        <strong>Search</strong>
        <span class="quick-search__hint"></span>
        <button type="button" class="quick-search__close" aria-label="Close">×</button>
      </div>
      <div id="quick-search-root" class="quick-search__root"></div>
    </dialog>

    <script is:inline type="module" src={`${BASE_URL}quick-search.mjs`}></script>

    <PretextEnhancer />
  </body>
</html>
