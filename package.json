{
  "name": "jingkaitang-github-io",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "npm run sync:assets && npm run search:dev",
    "dev": "astro dev",
    "dev:watch": "node scripts/dev-watch.mjs",
    "search:dev": "astro build && pagefind --site dist",
    "sync:assets": "node scripts/sync-writing-assets.mjs",
    "new:post": "node scripts/new-post.mjs",
    "new:now": "node scripts/new-now.mjs",
    "publish:writing": "node scripts/publish-writing.mjs",
    "publish:writing:draft": "node scripts/publish-writing-draft.mjs",
    "publish:writing:final": "node scripts/publish-writing-final.mjs",
    "publish:writing:confirm": "node scripts/publish-writing-confirm.mjs",
    "sync:wechat": "node scripts/wechat-sync.mjs",
    "wechat:status": "node scripts/wechat-status.mjs",
    "edit:writing": "node scripts/edit-writing.mjs",
    "edit:now": "node scripts/edit-now.mjs",
    "backfill:pubdate": "node scripts/backfill-pubdate-time.mjs",
    "deploy:ensure": "node scripts/ensure-pages-deploy.mjs --wait",
    "publish:now": "node scripts/publish-now.mjs",
    "check": "astro check",
    "prebuild": "npm run sync:assets",
    "build": "node scripts/build-footer-gallery.mjs && astro build && pagefind --site dist",
    "update:pins": "node scripts/fetch-github-pins.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:size": "node scripts/audit-size.mjs",
    "compress:images": "node scripts/compress-images.mjs",
    "validate:publish": "node scripts/validate-publish.mjs",
    "preview": "astro preview",
    "preview:lan": "node scripts/preview-lan.mjs",
    "astro": "astro"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@mermaid-js/mermaid-cli": "11.12.0",
    "gray-matter": "^4.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.17",
    "@chenglou/pretext": "^0.0.3",
    "astro": "^6.0.8",
    "chokidar": "^3.6.0",
    "lunar-javascript": "^1.7.4",
    "pagefind": "^1.3.0"
  }
}
